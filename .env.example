# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Upstash Redis (REST API)
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# LLM — Mistral (used by CrewAI via LiteLLM and AutoGen)
MISTRAL_API_KEY=your-mistral-api-key
LITELLM_MODEL=mistral/mistral-small-latest

# Flask agent ports (optional overrides)
ORDER_AGENT_PORT=5001
INVENTORY_AGENT_PORT=5002
REFUND_AGENT_PORT=5003
ESCALATION_AGENT_PORT=5004

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# CrewAI — disable cloud tracing (recommended for local Windows)
CREWAI_TRACING_ENABLED=false
CREWAI_TESTING=true
OTEL_SDK_DISABLED=true
