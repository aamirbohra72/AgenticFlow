{
  "name": "agentic-order-flow",
  "private": true,
  "workspaces": [
    "apps/*",
    "agents/*"
  ],
  "scripts": {
    "dev:infra": "docker compose up",
    "dev": "turbo run dev --parallel",
    "migrate": "cd apps/orchestrator && python manage.py migrate",
    "seed": "cd apps/orchestrator && python manage.py seed_demo_data",
    "test": "cd apps/orchestrator && python -m pytest && cd ../../agents/refund_agent && python -m pytest tests -q"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.0.0"
}
